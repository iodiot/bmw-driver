<dialog id="gallery-dialog" class="ppDialog" role="dialog" aria-modal="true" aria-labelledby="gallery-dialog-title">
    <div class="ppDialog-header-wrapper">
        <div id="gallery-dialog-title" class="ppDialog-header-title" role="heading" aria-level="2">Download Media Kit</div>
        <div class="ppDialog-header-close-button ppDialog-close-button" data-dialog-action="cancel" aria-label="Close dialog" role="button" tabindex="0">
            <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#717171"><path d="m256-168-88-88 224-224-224-224 88-88 224 224 224-224 88 88-224 224 224 224-88 88-224-224-224 224Z"/></svg>
        </div>
    </div>

    <div class="ppDialog-content">
            <div id="gallery-dialog-waiting-wrapper">
        <div id="gallery-dialog-waiting-spinner">
            <svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
                <circle cx="50" cy="50" r="44"/>
            </svg>
        </div>
        <div>Preparing your download...</div>
    </div>
    <a
            id="gallery-dialog-download-button"
            class="ppDialog-hidden"
            href="#"
            title="Download"
    >
        Download
        <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed"><path d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z"/></svg>
    </a>
    <p id="gallery-dialog-error" class="ppDialog-hidden">
        An error occurred while preparing your download
    </p>

    </div>
</dialog>
<style>
    @keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }

    dialog:focus,
    dialog:focus-visible {
        outline: none;
    }

    dialog.ppDialog::backdrop {
        background-color: black;
        opacity: 0.65;
    }

    dialog.ppDialog {
        display: none;
    }

    dialog.ppDialog[open] {
        display: initial;
    }

    dialog.ppDialog[open] {
        border-radius: 20px;
        border: 1px solid white;
        box-shadow: 5px 5px 15px black;
        padding: 30px;
        margin: auto;

        &:hover {
            cursor: auto;
        }

        .ppDialog-hidden {
            opacity: 0 !important;
            position: absolute !important;
            visibility: hidden !important;
        }

        .ppDialog-header-wrapper {
            align-items: center;
            display: flex;
            gap: 45px;
            justify-content: space-between;
            margin-bottom: 30px;

            .ppDialog-header-title {
                font-size: 1.2rem;
            }

            .ppDialog-header-close-button {
                align-items: center;
                color: #717171;
                display: flex;
                font-size: 1.5em;
                font-weight: bold;
                height: 1.5em;
                justify-content: center;
                width: 1.5em;

                &:hover {
                    cursor: pointer;
                }
            }
        }

        .ppDialog-content {
            align-items: center;
            display: flex;
            flex-direction: row;
            justify-content: center;

        }
    }

    dialog.ppDialog[open] {
        .ppDialog-content {
            #dialog-waiting-wrapper,
            #dialog-download-button,
            #galley-dialog-waiting-wrapper,
            #gallery-dialog-download-button {
                opacity: 1;
                transition: opacity 0.5s ease-in-out;
            }

            #dialog-waiting-wrapper, #gallery-dialog-waiting-wrapper {
                align-items: center;
                display: flex;
                flex-direction: row;
                gap: 20px;
                justify-content: center;

                #dialog-waiting-spinner, #gallery-dialog-waiting-spinner {
                    height: 1.4em;
                    width: 1.4em;

                    svg {
                        display: block;
                        height: 100%;
                        overflow: visible;
                        width: 100%;

                        circle {
                            animation: spin 1s linear infinite;
                            fill: none;
                            stroke-dasharray: 140 65;
                            stroke-linecap: round;
                            stroke-width: 12;
                            stroke: black;
                            transform-origin: 50% 50%;
                        }
                    }
                }
            }

            #dialog-download-button,
            #gallery-dialog-download-button {
                align-items: center;
                background-color: rgb(17, 48, 75);
                border-radius: 8px;
                color: white;
                display: flex;
                font-weight: bold;
                gap: 10px;
                justify-content: center;
                padding: 10px 20px;
                text-decoration: none;

                &:hover {
                    cursor: pointer;
                }
            }
        }
    }
</style>

<script >
    (function () {
        const dialogDownloadButton = document.querySelector('#gallery-dialog-download-button');
        const downloadDialog = document.getElementById('gallery-dialog');

        dialogDownloadButton.addEventListener('click', () => {
            setTimeout(() => {
                downloadDialog.close();
            }, 450);
        });

        document.addEventListener('DOMContentLoaded', () => {
            downloadDialog.querySelectorAll('[data-dialog-action="cancel"]')
                .forEach(btn => {
                    btn.addEventListener('click', () => downloadDialog.close());
                    btn.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            downloadDialog.close();
                        }
                    });
                });
        });

        pp_jquery(document).on('click', '#gallery-download-all-7936254', (event) => {
            event.preventDefault();
            const btn = event.currentTarget;
            const ready = btn.dataset.ready;
            const data = {"host":"https://newsroom.bmwgroup.com/","pageToken":"9h893mDTLh+Hhdz3b5ZIjsjr9O9wtY3H5Gk95XSOVPlhtKCSn0/noC5eIIBvQL30.f3be9bd02fabfb8a5409b528e77f9b854641a31b6dcf00d6a65fcb21b1d6aacf","moduleId":"7936254","hash":"81fee4c1bb3b956ba12ec6db5c7112c8a415f245","preview":""};

            if (ready === 'error') {
                downloadDialog.querySelector('#gallery-dialog-error').classList.add('ppDialog-hidden');
                downloadDialog.querySelector('#gallery-dialog-waiting-spinner').classList.add('ppDialog-hidden');
                downloadDialog.querySelector('#gallery-dialog-waiting-wrapper').classList.remove('ppDialog-hidden');
                btn.dataset.ready = 'false';
            }

            handleDownload(data, downloadDialog, btn);
            downloadDialog.showModal();
        });


        function handleDownload(data, dialog, triggerBtn) {
            const spinnerWrapper = dialog.querySelector('#gallery-dialog-waiting-wrapper');
            const errorPara = dialog.querySelector('#gallery-dialog-error');
            spinnerWrapper.classList.remove('ppDialog-hidden');
            dialogDownloadButton.classList.add('ppDialog-hidden');

            pp_jquery.post(`${data.host}services/assetDownloadGenerator.php`, {
                module: 'gallery',
                pageToken: data.pageToken,
                moduleId: data.moduleId,
                hash: data.hash,
                preview: data.preview
            }, resp => {
                if (resp.hash) {
                    window.ppAssetDownloadSSE(resp.hash, {
                        success: url => {
                            spinnerWrapper.classList.add('ppDialog-hidden');
                            dialogDownloadButton.href = url;
                            dialogDownloadButton.classList.remove('ppDialog-hidden');
                            triggerBtn.dataset.ready = 'true';
                        },
                        error: err => {
                            console.error(err);
                            spinnerWrapper.classList.add('ppDialog-hidden');
                            errorPara.classList.remove('ppDialog-hidden');
                            triggerBtn.dataset.ready = 'error';
                        }
                    });
                } else {
                    spinnerWrapper.classList.add('ppDialog-hidden');
                    errorPara.classList.remove('ppDialog-hidden');
                    triggerBtn.dataset.ready = 'error';
                }
            }).fail(() => {
                spinnerWrapper.classList.add('ppDialog-hidden');
                errorPara.classList.remove('ppDialog-hidden');
                triggerBtn.dataset.ready = 'error';
            });
        }
    })();
</script>
